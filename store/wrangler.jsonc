{
  // One Stop Shop, the real store. Separate from the mockup preview (../wrangler.jsonc), which stays as it is.
  // Not launched: every page carries noindex until LIVE is set to "1".
  "name": "onestopshop-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker answers every page and data route (own title per page, a real 404 for anything unknown).
    // Images, fonts, scripts and styles go straight out without waking it.
    "run_worker_first": ["/*", "!/img/*", "!/fonts/*", "!/*.js", "!/*.css"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "onestopshop", "database_id": "b7386cbb-2597-4060-838f-230e6b7c54e6", "migrations_dir": "migrations" }
  ],
  // Nightly backup at 3 am Windsor time (4 am in summer): one file a day in the BACKUPS bucket, the last 30 kept.
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "onestopshop-backups" }],
  "triggers": { "crons": ["0 8 * * *", "*/10 * * * *"] },   // the second: unpaid orders checked with Stripe (src/pay.js sweep)
  // Card payment turns on once STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET (secrets) are set: store/docs/PAYMENTS.md.
  // Order emails send once RESEND_API_KEY (a secret) and EMAIL_FROM are set. Until then they are written and held.
  // Launch: set LIVE to "1" and SITE_ORIGIN to the shop's own address (https://the-domain, no slash). Pages, sitemap and robots.txt
  // then index on that address only; the workers.dev copy keeps noindex and points its canonical there. store/docs/SEO.md.
  "vars": { "LIVE": "0", "SITE_NAME": "One Stop Shop", "SITE_ORIGIN": "" }
}
